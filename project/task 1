#include <iostream>
#include <cstdlib>
#include <ctime>

int main(){
     srand(time(0));
     int num=rand() %10+1;
     int g;

     do {
        std::cout <<"guess the number (1 to 10): ";
        std::cin >> g;
     
        if (g>num){
            std::cout <<"too high!try again.\n";
        } else if(g<num) {
            std::cout <<"too low!try again.\n";

        }

    } while (g!=num);
      
    std::cout <<"congratulations!you guessed the number.\n";
    return 0;
}
