#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;
int main(){
     int b;
     srand(time(0));
     int num = rand()%10+1;

     do {
        cout <<"Guess the number (1 to 10): ";
        cin >> b;
     
        if (b>num){
            cout <<"Too high!try again.\n";
        } else if(b<num) {
            cout <<"Too low!try again.\n";

        } else {
             cout <<"Congratulations! you guessed the number.\n";
        }   
    } while (b !=num);
      
    return 0;
}
